{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "react"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "cakranala": ["./src/index.ts"],
      "cakranala/collect": ["./src/collect/index.ts"],
      "cakranala/embed": ["./src/embed/index.ts"],
      "cakranala/scenarios/*": ["./scenarios/*"],
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["src", "test", "web/src", "web/config", "scripts"]
}
